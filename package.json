{
  "name": "@clockgrove/assetgrove",
  "version": "0.2.0",
  "description": "Generates game assets through generation models and hands them to a game's own asset pipeline with full provenance.",
  "keywords": [
    "game-assets",
    "gamedev",
    "asset-generation",
    "provenance",
    "cli",
    "mcp",
    "agent-skills"
  ],
  "license": "MIT",
  "homepage": "https://github.com/clockgrove/assetgrove#readme",
  "bugs": {
    "url": "https://github.com/clockgrove/assetgrove/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clockgrove/assetgrove.git"
  },
  "type": "module",
  "exports": {
    "./extension": {
      "assetgrove-source": "./src/extension/api.ts",
      "types": "./dist/extension/api.d.ts",
      "default": "./dist/extension/api.js"
    },
    "./testing": {
      "assetgrove-source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "assetgrove": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "policy"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "assetgrove": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "prettier --check . && eslint . && tsc --noEmit",
    "format": "prettier --write .",
    "prepack": "pnpm build",
    "test": "node scripts/test.ts",
    "test:real": "node --test --test-isolation=none \"test/real/**/*.real.ts\"",
    "gate": "node scripts/gate.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.105",
    "@ai-sdk/openai": "4.0.118",
    "@ai-sdk/openai-compatible": "3.0.92",
    "@auth0/cose": "1.0.2",
    "@contentauth/c2pa-wasm": "0.15.0",
    "@modelcontextprotocol/server": "2.4.0",
    "ai": "7.0.173",
    "ase-parser": "0.0.19",
    "asn1js": "4.0.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "jpeg-js": "0.4.4",
    "jsonc-parser": "3.3.1",
    "ktx-parse": "2.0.0",
    "meshoptimizer": "1.3.0",
    "music-metadata": "12.7.0",
    "pkijs": "4.0.1",
    "pngjs": "7.0.0",
    "semver": "7.8.6",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "25.9.9",
    "@types/pngjs": "6.0.5",
    "@types/semver": "7.8.0",
    "cbor2": "2.4.2",
    "eslint": "10.14.0",
    "exiftool-vendored": "39.3.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
