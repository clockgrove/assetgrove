{
  "name": "@clockgrove/assetgrove-search",
  "version": "0.2.0",
  "description": "Optional search for Assetgrove libraries: store and embedder interfaces, pinned SigLIP2 embeddings.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clockgrove/assetgrove.git",
    "directory": "packages/assetgrove-search"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "assetgrove": {
    "api": 3,
    "entry": "./dist/extension.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p ../../tsconfig.build.json --emitDeclarationOnly && tsc -p tsconfig.build.json",
    "check": "prettier --check . && eslint . && tsc --noEmit",
    "format": "prettier --write .",
    "pin-model": "node scripts/pin-model.ts",
    "prepack": "pnpm build",
    "test": "node --conditions=assetgrove-source --test \"test/**/*.test.ts\""
  },
  "peerDependencies": {
    "@clockgrove/assetgrove": "^0.2.0"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@lancedb/lancedb": "0.41.0",
    "apache-arrow": "21.2.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@clockgrove/assetgrove": "link:../..",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
