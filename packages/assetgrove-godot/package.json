{
  "name": "@clockgrove/assetgrove-godot",
  "version": "0.2.0",
  "description": "Godot hand-off for Assetgrove: SpriteFrames and TileSets built, saved and reloaded, and glTF characters imported and checked, by a pinned headless Godot.",
  "keywords": [
    "assetgrove",
    "godot",
    "spriteframes",
    "tileset",
    "gltf",
    "gamedev"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clockgrove/assetgrove.git",
    "directory": "packages/assetgrove-godot"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "assetgrove": {
    "api": 3,
    "entry": "./dist/extension.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p ../../tsconfig.build.json --emitDeclarationOnly && tsc -p tsconfig.build.json && node --input-type=module -e \"import { copyFileSync } from 'node:fs'; copyFileSync('src/build.gd', 'dist/build.gd');\"",
    "check": "prettier --check . && eslint . && tsc --noEmit",
    "format": "prettier --write .",
    "prepack": "pnpm build",
    "test": "node --conditions=assetgrove-source --test \"test/**/*.test.ts\""
  },
  "peerDependencies": {
    "@clockgrove/assetgrove": "^0.2.0"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@clockgrove/assetgrove": "link:../..",
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "4.5.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
